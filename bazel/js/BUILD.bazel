load("@aspect_rules_js//js:defs.bzl", "js_library", "js_test")
load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")

exports_files([
    "esbuild_bundle.config.mjs.tpl",
    "esbuild_prebundle.config.mjs.tpl",
    "css.d.ts",
])

bool_flag(
    name = "dev",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

config_setting(
    name = "is_dev",
    flag_values = {":dev": "True"},
    visibility = ["//visibility:public"],
)

js_library(
    name = "css_types",
    srcs = ["css.d.ts"],
    visibility = ["//visibility:public"],
)

js_test(
    name = "config_test",
    data = ["esbuild_bundle.config.mjs.tpl"],
    entry_point = "config.test.js",
)
